# SCOPE — Ortam Değişkenleri (örnek)
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` git'e commit EDİLMEZ.

# PostgreSQL bağlantı dizesi (zorunlu — drizzle.config.ts & server/db.ts)
DATABASE_URL=

# Google Gemini (AI kimlik tespiti) — server/routes.ts kullanır
AI_INTEGRATIONS_GEMINI_API_KEY=
# Opsiyonel: özel Gemini proxy/base URL (Replit AI Integrations için). Boş bırakılabilir.
AI_INTEGRATIONS_GEMINI_BASE_URL=

# SerpAPI (çok-bölgeli gerçek fiyat verisi) — server/serpapi.ts
SERPAPI_KEY=

# Ximilar Fashion AI (kategori/renk/malzeme) — server/ximilar.ts
XIMILAR_API_KEY=

# Clarifai (genel görsel tanıma) — server/clarifai.ts
CLARIFAI_API_KEY=

# Oturum anahtarı (ileride auth için)
SESSION_SECRET=

# Mobil istemcinin backend'e ulaşacağı domain (Expo) — client/lib/query-client.ts
# Örn. lokal: localhost:5000
EXPO_PUBLIC_DOMAIN=
