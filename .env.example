# SCOPE — Ortam Değişkenleri (örnek)
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur. `.env` git'e commit EDİLMEZ.
# Kurulum rehberi: KURULUM.md

# ─────────────────────────────────────────────────────────────
# ZORUNLU — uygulamanın tarama + AI analizi çalışması için tek gereken bu:
# ─────────────────────────────────────────────────────────────

# AI ürün tanıma — İKİSİNDEN BİRİ yeter. İkisi de varsa OpenRouter kullanılır.
# OpenRouter (tek anahtar, birçok model): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Sırayla denenecek modeller (opsiyonel, virgülle):
# OPENROUTER_MODELS=google/gemini-2.5-flash,google/gemini-2.5-flash-lite
# Google Gemini (doğrudan). Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpAPI — ABD / Avrupa / Türkiye'deki gerçek mağaza fiyatları ve linkleri.
# Yoksa ürün yine tanınır ama fiyat listesi yerine mağaza arama linkleri gösterilir.
# https://serpapi.com
SERPAPI_KEY=
# Aranacak ülkeler (opsiyonel; her ülke 1 SerpAPI araması = maliyet):
# PRICE_COUNTRIES=US,DE,FR,IT,ES,UK,TR

# ─────────────────────────────────────────────────────────────
# OPSİYONEL — bunlar olmadan da uygulama çalışır (özellikler kısmen devre dışı)
# ─────────────────────────────────────────────────────────────

# PostgreSQL bağlantısı. Yoksa: tarama/AI çalışır, sadece bulut portföy senkronu kapalı
# (portföy yine de telefonda yerel olarak saklanır). Örn: postgresql://user:pass@host:5432/db
DATABASE_URL=




# ─────────────────────────────────────────────────────────────
# Geliştirme (genelde dokunmana gerek yok)
# ─────────────────────────────────────────────────────────────

# Mobil istemcinin backend'e ulaşacağı domain (production). Boşsa dev modunda
# istemci LAN IP'yi otomatik bulur (telefon ile aynı WiFi).
EXPO_PUBLIC_DOMAIN=

# Production CORS allowlist (virgülle ayrılmış domainler). Boşsa dev'de localhost açık.
# ALLOWED_ORIGINS=app.scope.example

# Kendi Gemini proxy'ni kullanıyorsan (normalde gerekmez):
# GEMINI_BASE_URL=

# Telemetri (opsiyonel) — ayarlanırsa scan eventleri PostHog'a da gider
# POSTHOG_KEY=phc_xxx
# POSTHOG_HOST=https://app.posthog.com

# Affiliate (opsiyonel) — ayarlanırsa mağaza linklerine tag eklenir
# AMAZON_AFFILIATE_TAG=scope-20
# AFFILIATE_TAGS={"trendyol.com":"utm_source=scope"}

# ─────────────────────────────────────────────────────────────
# HESAPLAR + PRO ABONELİK (dev build gerekir — Expo Go'da çalışmaz)
# ─────────────────────────────────────────────────────────────

# SCOPE oturum token'ı imzalama anahtarı (32+ rastgele karakter). ZORUNLU (hesaplar için).
# Üret: `openssl rand -hex 32`
SESSION_SECRET=

# Apple Sign-In: doğrulanacak audience = iOS bundle id (virgülle birden fazla olabilir)
APPLE_BUNDLE_ID=com.scope.assetvision

# Google Sign-In: id_token'ın geçerli olduğu OAuth client id'leri (virgülle ayrılmış).
# Boşsa imza+issuer doğrulanır ama audience atlanır (sadece dev kolaylığı).
GOOGLE_CLIENT_IDS=

# RevenueCat webhook paylaşılan sırrı (dashboard → webhook → Authorization header).
REVENUECAT_WEBHOOK_SECRET=

# ── İstemci (EXPO_PUBLIC_*) — build'e gömülür ──

# Google OAuth client id'leri (expo-auth-session). Google Cloud Console'dan al.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK anahtarları (RevenueCat → API keys).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
