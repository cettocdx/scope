# SCOPE — Ortam Değişkenleri (örnek)
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur. `.env` git'e commit EDİLMEZ.
# Kurulum rehberi: KURULUM.md

# ─────────────────────────────────────────────────────────────
# ZORUNLU — uygulamanın tarama + AI analizi çalışması için tek gereken bu:
# ─────────────────────────────────────────────────────────────

# Google Gemini (AI ürün tanıma). Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# OPSİYONEL — bunlar olmadan da uygulama çalışır (özellikler kısmen devre dışı)
# ─────────────────────────────────────────────────────────────

# PostgreSQL bağlantısı. Yoksa: tarama/AI çalışır, sadece bulut portföy senkronu kapalı
# (portföy yine de telefonda yerel olarak saklanır). Örn: postgresql://user:pass@host:5432/db
DATABASE_URL=

# SerpAPI — gerçek çok-bölgeli fiyat verisi. Yoksa fiyatlar AI tahminine dayanır.
# Ücretsiz tier: https://serpapi.com
SERPAPI_KEY=

# Ximilar — moda/ürün görsel tanıma (kategori/renk/malzeme). https://www.ximilar.com
XIMILAR_API_KEY=

# Clarifai — genel görsel tanıma. https://www.clarifai.com
CLARIFAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Geliştirme (genelde dokunmana gerek yok)
# ─────────────────────────────────────────────────────────────

# Mobil istemcinin backend'e ulaşacağı domain. Boşsa dev modunda http://localhost:5000 kullanılır.
EXPO_PUBLIC_DOMAIN=

# Replit AI Integrations proxy kullanıyorsan (normalde gerekmez):
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=

# Telemetri (opsiyonel) — ayarlanırsa scan eventleri PostHog'a da gider
# POSTHOG_KEY=phc_xxx
# POSTHOG_HOST=https://app.posthog.com
